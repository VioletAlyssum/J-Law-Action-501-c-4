# JenniferslawAction.org — server configuration TEMPLATE
#
# Copy this file to ".env", fill in the real values, and place it ONE LEVEL
# ABOVE public_html so it can never be downloaded over the web:
#     /home/uXXXXXXXXX/domains/jenniferslawaction.org/.env      <-- correct
# Never commit the real .env to git.

# Petitions (api/petition-sign.php)
# Signatures are stored in a SQLite file created automatically in
# /home/uXXXXXXXXX/domains/jenniferslawaction.org/jl-data/  (above public_html).
# Long random string required to download signatures as CSV:
#   https://www.jenniferslawaction.org/api/petition-sign.php?export=all&key=...
PETITION_ADMIN_KEY=
# Long random string used to hash visitor IP addresses for rate limiting.
PETITION_SALT=
# Optional: MySQL instead of SQLite.
# PETITION_DB_DSN=
# PETITION_DB_USER=
# PETITION_DB_PASS=

# Optional. Comma-separated origins permitted to post to the API.
# Leave blank to allow only the domain the request arrived on.
JL_ALLOWED_ORIGINS=
