# JenniferslawAction.org — /api hardening

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|md|bak|sql|sqlite|db|json|yml|yaml)$">
  Require all denied
</FilesMatch>

# Only petition-sign.php is meant to be reachable here.
<FilesMatch "^(?!(petition-sign)\.php$).*\.php$">
  Require all denied
</FilesMatch>

Options -Indexes
